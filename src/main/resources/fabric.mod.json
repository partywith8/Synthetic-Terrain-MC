{
  "schemaVersion": 1,
  "id": "epd",
  "version": "${version}",
  "name": "Synthetic Terrain MC",
  "description": "STM: mineable blocks with continuous terrain motion, shared physics and GPU rendering.",
  "authors": [
    "partywith8"
  ],
  "contact": {
    "sources": "https://github.com/partywith8/SyntheticTerrain-MC",
    "issues": "https://github.com/partywith8/SyntheticTerrain-MC/issues"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.partywith8.epd.Epd"
    ],
    "client": [
      "io.github.partywith8.epd.client.EpdClient"
    ]
  },
  "mixins": [
    "epd.mixins.json",
    {
      "config": "epd.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.152.1"
  }
}
